* text=auto eol=lf

# Binary scientific/recording artifacts
*.mat binary
*.bdf binary
*.edf binary
*.otb4 binary
*.otb+ binary
*.npz binary
*.h5 binary

# Launchers: CMD and PowerShell want CRLF, the shell launcher must stay LF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.command text eol=lf
*.sh text eol=lf
